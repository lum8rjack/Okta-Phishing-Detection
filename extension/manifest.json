{
  "name": "Okta Phishing Detection",
  "version": "2026.2.1",
  "description": "Helps protect users from phishing by displaying a prominent warning banner on Okta login pages, alerting them to potential risks or suspicious sites.",
  "manifest_version": 3,
  "author": "lum8rjack",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "content_scripts":[
    {
     "matches":["<all_urls>"],
     "js":["main.js"],
     "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Okta Phishing Detection",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon_48.png",
      "96": "icon_96.png",
      "128": "icon_128.png"
    }
  },
  "icons": {
    "48": "icon_48.png",
    "96": "icon_96.png",
    "128": "icon_128.png"
  }
}